{
  "name": "codegroup-file-organizer",
  "displayName": "CodeGroup - File Bookmarks & Organizer",
  "description": "Bookmark and organize related files into custom groups in VS Code. Create bookmark folders, smart groups, and working sets without moving files.",
  "version": "1.4.1",
  "publisher": "PeterDev",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiszterSoul/codegroup"
  },
  "bugs": {
    "url": "https://github.com/MiszterSoul/codegroup/issues"
  },
  "homepage": "https://github.com/MiszterSoul/codegroup#readme",
  "keywords": [
    "file organizer",
    "file groups",
    "bookmarks",
    "favorites",
    "file manager",
    "workspace",
    "productivity",
    "project management",
    "collections",
    "drag and drop",
    "tab groups",
    "file tabs",
    "organize files",
    "multi-root",
    "monorepo",
    "code organization",
    "code navigation",
    "working sets",
    "smart groups",
    "developer productivity",
    "vscode sidebar",
    "explorer",
    "project files",
    "file bookmarks",
    "folder bookmarks",
    "bookmark folders",
    "vscode bookmarks",
    "code bookmarks",
    "project bookmarks",
    "sidebar bookmarks"
  ],
  "galleryBanner": {
    "color": "#5C6BC0",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "fileGroupsView",
          "name": "CodeGroup",
          "visibility": "collapsed",
          "order": 2
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "codegroup.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "understand-bookmarks",
            "title": "%walkthrough.step.bookmarks.title%",
            "description": "%walkthrough.step.bookmarks.description%",
            "media": {
              "image": "images/screenshot-quick-actions.png",
              "altText": "%walkthrough.step.bookmarks.alt%"
            },
            "completionEvents": [
              "onView:fileGroupsView"
            ]
          },
          {
            "id": "create-first-group",
            "title": "%walkthrough.step.create.title%",
            "description": "%walkthrough.step.create.description%",
            "media": {
              "image": "images/screenshot-quick-actions.png",
              "altText": "%walkthrough.step.create.alt%"
            },
            "completionEvents": [
              "onCommand:fileGroups.createGroup"
            ]
          },
          {
            "id": "add-working-files",
            "title": "%walkthrough.step.add.title%",
            "description": "%walkthrough.step.add.description%",
            "media": {
              "image": "images/screenshot-group-editor.png",
              "altText": "%walkthrough.step.add.alt%"
            },
            "completionEvents": [
              "onCommand:fileGroups.addFile",
              "onCommand:fileGroups.createGroupFromOpenEditors",
              "onCommand:fileGroups.createGroupFromGitChanges"
            ]
          },
          {
            "id": "use-bookmark-tools",
            "title": "%walkthrough.step.tools.title%",
            "description": "%walkthrough.step.tools.description%",
            "media": {
              "image": "images/screenshot-group-editor.png",
              "altText": "%walkthrough.step.tools.alt%"
            },
            "completionEvents": [
              "onCommand:fileGroups.openGroupEditor",
              "onCommand:fileGroups.quickOpen"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "fileGroups.changeLanguage",
        "title": "%command.changeLanguage.title%",
        "icon": "$(globe)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.createSmartGroups",
        "title": "%command.createSmartGroups.title%",
        "icon": "$(sparkle)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.importSharedGroup",
        "title": "%command.importSharedGroup.title%",
        "icon": "$(cloud-download)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.exportGroupShare",
        "title": "%command.exportGroupShare.title%",
        "icon": "$(cloud-upload)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.copyFilePaths",
        "title": "%command.copyFilePaths.title%",
        "icon": "$(copy)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.groupActions",
        "title": "%command.groupActions.title%",
        "icon": "$(ellipsis)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.quickOpen",
        "title": "%command.quickOpen.title%",
        "icon": "$(search)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.createGroup",
        "title": "%command.createGroup.title%",
        "icon": "$(add)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.createGroupFromOpenEditors",
        "title": "%command.createGroupFromOpenEditors.title%",
        "icon": "$(files)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.createGroupFromGitChanges",
        "title": "%command.createGroupFromGitChanges.title%",
        "icon": "$(source-control)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.createSubgroup",
        "title": "%command.createSubgroup.title%",
        "icon": "$(new-folder)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.deleteGroup",
        "title": "%command.deleteGroup.title%",
        "icon": "$(trash)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.deleteGroupFromTitle",
        "title": "%command.deleteGroupFromTitle.title%",
        "icon": "$(trash)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.renameGroup",
        "title": "%command.renameGroup.title%",
        "icon": "$(edit)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.openGroupEditor",
        "title": "%command.openGroupEditor.title%",
        "icon": "$(settings-gear)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.setGroupIcon",
        "title": "%command.setGroupIcon.title%",
        "icon": "$(symbol-misc)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.setGroupColor",
        "title": "%command.setGroupColor.title%",
        "icon": "$(symbol-color)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.editGroupSummary",
        "title": "%command.editGroupSummary.title%",
        "icon": "$(note)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.editGroupDetails",
        "title": "%command.editGroupDetails.title%",
        "icon": "$(comment-discussion)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.addFile",
        "title": "%command.addFile.title%",
        "icon": "$(add)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.addFileFromTab",
        "title": "%command.addFile.title%",
        "icon": "$(add)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.goToGroup",
        "title": "%command.goToGroup.title%",
        "icon": "$(link)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.removeFile",
        "title": "%command.removeFile.title%",
        "icon": "$(remove)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.openDirect",
        "title": "%command.openDirect.title%",
        "icon": "$(go-to-file)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.openAll",
        "title": "%command.openAll.title%",
        "icon": "$(files)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.closeAll",
        "title": "%command.closeAll.title%",
        "icon": "$(close-all)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.expandAll",
        "title": "%command.expandAll.title%",
        "icon": "$(expand-all)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.collapseAll",
        "title": "%command.collapseAll.title%",
        "icon": "$(collapse-all)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.moveToRoot",
        "title": "%command.moveToRoot.title%",
        "icon": "$(arrow-up)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.cleanupMissingFiles",
        "title": "%command.cleanupMissingFiles.title%",
        "icon": "$(clear-all)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.pinGroup",
        "title": "%command.pinGroup.title%",
        "icon": "$(pin)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.unpinGroup",
        "title": "%command.unpinGroup.title%",
        "icon": "$(pinned)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.setBadgeText",
        "title": "%command.setBadgeText.title%",
        "icon": "$(tag)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.findDuplicates",
        "title": "%command.findDuplicates.title%",
        "icon": "$(copy)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.sortFiles",
        "title": "%command.sortFiles.title%",
        "icon": "$(sort-precedence)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.moveToGlobal",
        "title": "%command.moveToGlobal.title%",
        "icon": "$(globe)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.moveToLocal",
        "title": "%command.moveToLocal.title%",
        "icon": "$(home)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.duplicateGroup",
        "title": "%command.duplicateGroup.title%",
        "icon": "$(copy)",
        "category": "%category.fileGroups%"
      },
      {
        "command": "fileGroups.openGlobalConfig",
        "title": "%command.openGlobalConfig.title%",
        "icon": "$(go-to-file)",
        "category": "%category.fileGroups%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fileGroups.createGroup",
          "when": "view == fileGroupsView",
          "group": "navigation@1"
        },
        {
          "command": "fileGroups.changeLanguage",
          "when": "view == fileGroupsView",
          "group": "navigation@2"
        },
        {
          "command": "fileGroups.quickOpen",
          "when": "view == fileGroupsView",
          "group": "navigation@3"
        },
        {
          "command": "fileGroups.deleteGroupFromTitle",
          "when": "view == fileGroupsView",
          "group": "navigation@4"
        },
        {
          "command": "fileGroups.expandAll",
          "when": "view == fileGroupsView",
          "group": "navigation@5"
        },
        {
          "command": "fileGroups.collapseAll",
          "when": "view == fileGroupsView",
          "group": "navigation@6"
        },
        {
          "command": "fileGroups.refresh",
          "when": "view == fileGroupsView",
          "group": "navigation@7"
        },
        {
          "command": "fileGroups.findDuplicates",
          "when": "view == fileGroupsView",
          "group": "navigation@8"
        }
      ],
      "view/context": [
        {
          "command": "fileGroups.createGroup",
          "when": "view == fileGroupsView",
          "group": "1_create"
        },
        {
          "command": "fileGroups.createSmartGroups",
          "when": "view == fileGroupsView",
          "group": "1_create@0"
        },
        {
          "command": "fileGroups.createGroupFromOpenEditors",
          "when": "view == fileGroupsView",
          "group": "1_create@1"
        },
        {
          "command": "fileGroups.createGroupFromGitChanges",
          "when": "view == fileGroupsView",
          "group": "1_create@2"
        },
        {
          "command": "fileGroups.importSharedGroup",
          "when": "view == fileGroupsView",
          "group": "2_share"
        }
      ],
      "view/item/context": [
        {
          "command": "fileGroups.openDirect",
          "when": "view == fileGroupsView && viewItem =~ /^group/",
          "group": "inline@1"
        },
        {
          "command": "fileGroups.openAll",
          "when": "view == fileGroupsView && viewItem =~ /^group/",
          "group": "inline@2"
        },
        {
          "command": "fileGroups.closeAll",
          "when": "view == fileGroupsView && viewItem =~ /^group/",
          "group": "inline@3"
        },
        {
          "command": "fileGroups.openGroupEditor",
          "when": "view == fileGroupsView && viewItem =~ /^group/",
          "group": "inline@4"
        },
        {
          "command": "fileGroups.openDirect",
          "when": "view == fileGroupsView && viewItem =~ /group/",
          "group": "1_actions@1"
        },
        {
          "command": "fileGroups.openAll",
          "when": "view == fileGroupsView && viewItem =~ /group/",
          "group": "1_actions@2"
        },
        {
          "command": "fileGroups.closeAll",
          "when": "view == fileGroupsView && viewItem =~ /group/",
          "group": "1_actions@3"
        },
        {
          "command": "fileGroups.openGroupEditor",
          "when": "view == fileGroupsView && viewItem =~ /group/",
          "group": "2_modify@0"
        },
        {
          "command": "fileGroups.pinGroup",
          "when": "view == fileGroupsView && viewItem =~ /_unpinned$/",
          "group": "2_modify@1"
        },
        {
          "command": "fileGroups.unpinGroup",
          "when": "view == fileGroupsView && viewItem =~ /_pinned$/",
          "group": "2_modify@1"
        },
        {
          "command": "fileGroups.groupActions",
          "when": "view == fileGroupsView && viewItem =~ /group/",
          "group": "2_modify@2"
        },
        {
          "command": "fileGroups.copyFilePaths",
          "when": "view == fileGroupsView && viewItem =~ /group/",
          "group": "3_share@1"
        },
        {
          "command": "fileGroups.deleteGroup",
          "when": "view == fileGroupsView && viewItem =~ /group/",
          "group": "5_delete"
        },
        {
          "command": "fileGroups.openGlobalConfig",
          "when": "view == fileGroupsView && viewItem == globalSection",
          "group": "navigation"
        },
        {
          "command": "fileGroups.removeFile",
          "when": "view == fileGroupsView && viewItem == file",
          "group": "inline"
        },
        {
          "command": "fileGroups.removeFile",
          "when": "view == fileGroupsView && viewItem == file",
          "group": "1_actions"
        }
      ],
      "explorer/context": [
        {
          "command": "fileGroups.addFile",
          "when": "resourceScheme == file",
          "group": "7_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "fileGroups.addFileFromTab",
          "when": "resourceScheme == file",
          "group": "2_files"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codegroup.language": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "fr",
            "de",
            "hu",
            "es",
            "it",
            "pt-BR",
            "ja",
            "zh-CN"
          ],
          "enumDescriptions": [
            "English",
            "French",
            "German",
            "Hungarian",
            "Spanish",
            "Italian",
            "Portuguese (Brazil)",
            "Japanese",
            "Chinese (Simplified)"
          ],
          "markdownDescription": "%configuration.language.description%",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node build.js",
    "build": "npm run package",
    "test": "node --import tsx --test tests/manifest.test.js tests/quickOpen.test.js tests/smartGroups.test.js tests/sharedGroups.test.js tests/i18n.test.js tests/localization.test.js tests/pathUtils.test.js tests/groupFilePaths.test.js tests/multiRoot.test.js tests/accessibility.test.js",
    "test:extension": "npm run package && vscode-test",
    "verify": "npm run check-types && npm run lint && npm test",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node build.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run verify && node build.js --production",
    "package:vsix": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/codegroup-file-organizer.vsix",
    "package:list": "vsce ls",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "vsce:package": "npm run package:vsix",
    "vsce:publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "1.74.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
